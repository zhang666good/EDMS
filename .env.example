# Dify Agent API Keys (从 Dify 平台获取)
DIFY_AGENT_ANNUAL_REPORT_KEY=app-your-annual-report-key
DIFY_AGENT_DEEP_INSIGHT_KEY=app-your-deep-insight-key
DIFY_AGENT_AUTO_REPORT_KEY=app-your-auto-report-key

# Dify API Base URL (您的 Dify 服务器地址)
DIFY_API_BASE_URL=http://your-dify-server:8088/

# MinerU Token (文档解析服务，从 MinerU 平台获取)
MINERU_TOKEN=your-mineru-jwt-token-here

# 管理员账户（用于 Web 管理界面登录）
admin=your-admin-username
password=your-strong-password

# 百度语音识别 API（可选，如不需要可留空）
# BAIDU_STT_API_KEY=your-baidu-api-key
# BAIDU_STT_SECRET_KEY=your-baidu-secret-key
# BAIDU_STT_TIMEOUT=30
